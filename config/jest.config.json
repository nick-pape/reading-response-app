{
    "extends": "@rushstack/heft-jest-plugin/includes/jest-shared.config.json",
  
    "roots": ["<rootDir>/lib"],
  
    "testMatch": ["<rootDir>/lib/**/*.test.js"],
    "collectCoverageFrom": [
      "lib/**/*.js",
      "!lib/**/*.d.ts",
      "!lib/**/*.test.js",
      "!lib/**/test/**",
      "!lib/**/__tests__/**",
      "!lib/**/__fixtures__/**",
      "!lib/**/__mocks__/**"
    ]
  }